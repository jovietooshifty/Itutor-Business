# Supabase — from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only. Never expose to the browser, never commit.
# Used for privileged operations (team invites, admin reads).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Public origin, used to build verification + share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Quiz generation from ingested course content. Set at least one key; Gemini
# is preferred when both are present. Put real values in your own .env.local,
# never here.
#   Gemini:   https://aistudio.google.com/apikey
#   DeepSeek: https://platform.deepseek.com/api_keys
GEMINI_API_KEY=<gemini-api-key>
DEEPSEEK_API_KEY=<deepseek-api-key>

# Optional. Force a provider ("gemini" or "deepseek") instead of picking
# whichever key is set, or pin a different model.
# QUIZ_LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.8-flash

# Optional overrides for the local speech-to-text step (see
# src/lib/pipeline/README.md). Only needed if `python` is not the right
# executable, or you want a different Whisper model size.
# PYTHON_BIN=py
# WHISPER_MODEL_SIZE=base

# Dev-only: skip all auth checks so you can click through protected routes
# without signing in. Only takes effect with `next dev` (NODE_ENV=development)
# even if left set. Put this in your own .env.local, never here — it must
# never be true in a deployed environment.
# DEV_AUTH_BYPASS=true
