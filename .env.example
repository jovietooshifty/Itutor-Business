# Supabase — from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only. Never expose to the browser, never commit.
# Used for privileged operations (team invites, admin reads).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Public origin, used to build verification + share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
