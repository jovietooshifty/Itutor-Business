# Supabase — from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only. Never expose to the browser, never commit.
# Used for privileged operations (team invites, admin reads).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Public origin, used to build verification + share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Quiz generation from ingested course content. Set at least one key; Gemini
# is preferred when both are present. Put real values in your own .env.local,
# never here.
#   Gemini:   https://aistudio.google.com/apikey
#   DeepSeek: https://platform.deepseek.com/api_keys
GEMINI_API_KEY=<gemini-api-key>
DEEPSEEK_API_KEY=<deepseek-api-key>

# Optional. Force a provider ("gemini" or "deepseek") instead of picking
# whichever key is set, or pin a different model.
# QUIZ_LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.8-flash

# Speech-to-text for video/audio uses hosted Gemini by default and needs no
# setup beyond GEMINI_API_KEY above.
#
# Optional: pin the hosted models. Audio and video use different ones because
# the audio-only model rejects video input.
# GEMINI_STT_MODEL=gemini-3.5-transcribe
# GEMINI_STT_VIDEO_MODEL=gemini-3.1-flash-lite
#
# Optional: transcribe locally instead, so media never leaves the machine.
# Needs Python 3 + `pip install faster-whisper`, and cannot run on serverless.
# STT_PROVIDER=faster-whisper
# PYTHON_BIN=py
# WHISPER_MODEL_SIZE=base

# Dev-only: skip all auth checks so you can click through protected routes
# without signing in. Only takes effect with `next dev` (NODE_ENV=development)
# even if left set. Put this in your own .env.local, never here — it must
# never be true in a deployed environment.
# DEV_AUTH_BYPASS=true
